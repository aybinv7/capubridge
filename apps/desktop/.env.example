VITE_ENABLE_EXPERIMENTAL_FEATURES=true

# Jev automation policy (optional). Without an endpoint and a key the Jev
# policy fails every decision with "jev-not-configured" and an agent run halts
# on maxConsecutiveFailures before it reaches the device.
#
# Copy this file to .env.local (gitignored) and fill it in. Do NOT put a key in
# .env — that file is tracked by git. A shell export of the same name wins over
# the file.
#
# Two providers serve the same model, with different endpoints and slugs.
#
# OpenRouter (no TypeSafe waitlist needed):
#   CAPUBRIDGE_JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
#   CAPUBRIDGE_JEV_MODEL=typesafe/jev-1.13-20260917
#
# TypeSafe directly:
#   CAPUBRIDGE_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
#   CAPUBRIDGE_JEV_MODEL=jev-1.13
#
# On OpenRouter CAPUBRIDGE_JEV_MODEL is REQUIRED: policies/jev.ts pins the
# TypeSafe slug `jev-1.13`, which OpenRouter does not recognise. Use the dated
# slug above exactly; the `~typesafe/...` form is rejected as nonexistent. On
# TypeSafe it is optional. Pin a version rather than a "latest" alias:
# identical prompts are not comparable across model versions.
CAPUBRIDGE_JEV_ENDPOINT=
CAPUBRIDGE_JEV_API_KEY=
CAPUBRIDGE_JEV_MODEL=
