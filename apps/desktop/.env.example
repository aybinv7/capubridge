VITE_ENABLE_EXPERIMENTAL_FEATURES=true

# Jev automation policy (optional). Without an endpoint and a key the Jev
# policy fails every decision with "jev-not-configured" and an agent run halts
# on maxConsecutiveFailures before it reaches the device.
#
# Copy this file to .env.local (gitignored) and fill it in. Do NOT put a key in
# .env — that file is tracked by git. A shell export of the same name wins over
# the file.
#
# Either endpoint works; the model is chosen in the app (agent settings, next
# to the policy picker) from a capability table and defaults to Jev 1.14.
#
#   OpenRouter:       CAPUBRIDGE_JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
#   TypeSafe direct:  CAPUBRIDGE_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
#
# The app sends the OpenRouter slug and swaps in TypeSafe's own name when the
# endpoint is TypeSafe. CAPUBRIDGE_JEV_MODEL is no longer read: an override
# here would make the pre-send capability checks describe the wrong model.
CAPUBRIDGE_JEV_ENDPOINT=
CAPUBRIDGE_JEV_API_KEY=
